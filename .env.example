# ── TRON Network ──────────────────────────────────────────────────────────────
# Pick a named network or set TRON_FULL_HOST to a custom node URL.
#   mainnet  → https://api.trongrid.io
#   shasta   → https://api.shasta.trongrid.io  (testnet)
#   nile     → https://nile.trongrid.io        (testnet)

TRON_NETWORK=mainnet

# Optional: override the full node URL directly
# TRON_FULL_HOST=https://api.trongrid.io

# Optional: TronGrid API key (increases rate limits)
# Get one at https://www.trongrid.io/
TRON_API_KEY=

# ── Signing ────────────────────────────────────────────────────────────────────
# This MCP server has NO signing capability and never holds or contacts a
# private key. It only queries, builds unsigned transactions, and broadcasts
# transactions that were signed out-of-band (wherever you manage your keys).
