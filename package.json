{
  "name": "mcp-server-tronweb",
  "version": "1.0.0",
  "description": "MCP server exposing TronWeb APIs (TRON blockchain) for LLM/AI agents",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-tronweb": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tronweb3/mcp-server-tronweb.git"
  },
  "homepage": "https://github.com/tronweb3/mcp-server-tronweb#readme",
  "bugs": {
    "url": "https://github.com/tronweb3/mcp-server-tronweb/issues"
  },
  "author": "tronweb3",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tron",
    "tronweb",
    "blockchain",
    "ai-agent"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^16.4.7",
    "tronweb": "^6.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "axios": "^1.18.0",
    "ws": "^8.21.0"
  }
}
